{
  "name": "@blinklink/feed-rn",
  "version": "0.1.0",
  "description": "Blinklink server-driven short-form video feeds for React Native (iOS renderer; Android placeholder in 0.x).",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.tsx",
  "react-native": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "video",
    "feed",
    "blinklink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlinkLinkOrg/blinklink-feed-rn.git"
  },
  "author": "Blinklink <support@blinklink.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/BlinkLinkOrg/blinklink-feed-rn#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-builder-bob": "^0.30.2",
    "typescript": "^5.5.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
